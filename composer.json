{
    "name": "rschooltoday/idp-characterization",
    "description": "HTTP-only legacy IdP characterization tests",
    "type": "project",
    "license": "proprietary",
    "require-dev": {
        "php": ">=8.1",
        "ext-mysqli": "*",
        "phpunit/phpunit": "^9.6",
        "symfony/browser-kit": "6.4.*",
        "symfony/css-selector": "6.4.*",
        "symfony/dom-crawler": "6.4.*",
        "symfony/http-client": "6.4.*",
        "symfony/mime": "6.4.*"
    },
    "autoload": {
        "psr-4": {
            "Characterization\\": "Support/"
        }
    },
    "scripts": {
        "test": "php vendor/bin/phpunit",
        "test:unit": "php vendor/bin/phpunit --testsuite harness"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.29"
        }
    }
}
